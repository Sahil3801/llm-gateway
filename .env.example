# Copy to .env and fill in real values. .env is gitignored, never commit it.
# A provider with an empty key is simply treated as "not configured".

# Which provider answers requests: groq | gemini | cohere (default: groq)
LLM_PROVIDER=groq

# --- Groq (console.groq.com -> API Keys) ---
GROQ_API_KEY=

# --- Google Gemini (aistudio.google.com -> Get API key) ---
GEMINI_API_KEY=

# --- Cohere (dashboard.cohere.com -> API keys; a free trial key works) ---
COHERE_API_KEY=

# Optional model overrides (check each provider's console for current model names).
# Leave them commented out to use the defaults; an EMPTY value would override the default with nothing.
# GROQ_MODEL=
# GEMINI_MODEL=
# COHERE_MODEL=
